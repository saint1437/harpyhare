{
  "extends": "@harpyhare/tsconfig/react.json",
  "compilerOptions": {
    // The webview's language level, and the only reason this is not in the shared
    // preset: the landing ships ES2022/ES2023 to browsers.
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
