{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Audio System",
  "mainBinaryName": "Audio System",
  "version": "0.8.7",
  "identifier": "com.audioservice.helper",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Audio System",
        "width": 960,
        "height": 680,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "contentProtected": true,
        "minWidth": 300,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVBQjlENEVCMkFDRjA0MDcKUldRSEJNOHE2OVM1Nm9JTEtFc0pPekQxYkJlZnZ4aENEcHN2UXJWU1hnQVhTZ2hNVkpyd0xIZVEK",
      "endpoints": [
        "https://github.com/screenfriskofficial/harpyhare-releases/releases/latest/download/latest.json"
      ]
    }
  }
}
