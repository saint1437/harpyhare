{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"],
      "project": ["scripts/*.mjs"]
    },
    "apps/desktop": {
      "entry": ["src/launcher.tsx", "src/index.css"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignore": ["src/components/ui/**", "src/ipc/bindings.ts"],
      "ignoreBinaries": ["gh"]
    }
  }
}
