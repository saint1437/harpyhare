{
  "name": "@harpyhare/checks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The palette checks both apps run — token resolution and WCAG AA — with the palette left as an argument.",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "tokens.js",
    "contrast.js"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@harpyhare/eslint-config": "*",
    "@harpyhare/prettier-config": "*",
    "@harpyhare/tsconfig": "*",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.4",
    "prettier": "^3.8.4",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8"
  }
}
