  "updaterManifestName": "latest.json",
  "signatureSuffix": ".sig",
  "platforms": {
    "macos": {
      "updaterTarget": "darwin-aarch64",
      "installerSuffix": ".dmg",
      "updaterArtifactSuffix": ".app.tar.gz"
    },
    "windows": {
      "updaterTarget": "windows-x86_64",
      "installerSuffix": "-setup.exe",
      "updaterArtifactSuffix": "-setup.exe"
    }
  }
}
