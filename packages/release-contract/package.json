{
  "name": "@harpyhare/release-contract",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "How a release asset is named — read by the release script, the landing page and Rust.",
  "exports": {
    ".": {
      "types": "./contract.d.ts",
      "default": "./contract.js"
    },
    "./client": {
      "types": "./client.d.ts",
      "default": "./client.js"
    },
    "./release-assets.json": "./release-assets.json"
  },
  "files": [
    "contract.js",
    "contract.d.ts",
    "client.js",
    "client.d.ts",
    "release-assets.json"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@harpyhare/platform": "*"
  },
  "devDependencies": {
    "@harpyhare/eslint-config": "*",
    "@harpyhare/prettier-config": "*",
    "@harpyhare/tsconfig": "*",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.4",
    "prettier": "^3.8.4",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8",
    "yaml": "^2.9.0"
  }
}
