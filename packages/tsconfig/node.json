{
  "$schema": "https://json.schemastore.org/tsconfig",

  // The build-tool half of a project (vite.config.ts, vitest.config.ts): it runs in
  // Node, not in the browser, and it is a composite project so `tsc -b` can build it
  // as a reference. `outDir` stays with the project — the tsbuildinfo is its own.
  "extends": "./base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "moduleDetection": "force",
    "composite": true,
    "types": ["node"]
  }
}
